<scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>false</shadows>
      <grid>false</grid>

      <fog>
        <color>0.75 0.75 0.75 1.0</color>
        <type>exp2</type>
        <density>0.08</density>
      </fog>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 100 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <!-- Lower intensity diffuse prevents burning through fog shaders -->
      <diffuse>0.5 0.5 0.5 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <direction>-0.4 0.3 -0.8</direction>
    </light>

    <!-- ========================================================= -->
    <!-- TERRACED PIT (hollow ring benches, south-side ramp cut)     -->
    <!-- ========================================================= -->

    <model name="upper_bench_N">
      <static>true</static>
      <pose>0 100.0 -4.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>220 20.0 8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>220 20.0 8</size></box></geometry>
          <material>
            <ambient>0.30 0.24 0.18 1</ambient>
            <diffuse>0.38 0.32 0.24 1</diffuse>
          </material>
          <plugin filename="ignition-gazebo-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>310.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>

